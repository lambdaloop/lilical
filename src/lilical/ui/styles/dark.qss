/* High-contrast dark theme.
 *
 * Palette:
 *   bg-window:    #0e0e0e   (window background, near-black)
 *   bg-surface:   #1a1a1a   (panels, toolbars, status bar, sidebars)
 *   bg-surface-2: #262626   (inputs, alternating rows, hover state)
 *   bg-surface-3: #333333   (selected/focused element fill)
 *   border:       #555555   (visible separators, input borders)
 *   border-2:     #7a7a7a   (focused input border, strong separators)
 *   text:         #ffffff   (primary text — pure white for max contrast)
 *   text-2:       #c8c8c8   (secondary text)
 *   text-3:       #8a8a8a   (placeholder, disabled)
 *   accent:       #7eb5ff   (focus, selection, links)
 *   accent-2:     #3b82f6   (filled accent, today indicator)
 *   danger:       #ff6b6b
 *   success:      #6ee896
 */

QWidget {
    background-color: #0e0e0e;
    color: #ffffff;
    font-size: 11pt;
}

QMainWindow {
    background-color: #0e0e0e;
}

/* Toolbars and status bar */
QToolBar {
    background-color: #1a1a1a;
    border-bottom: 1px solid #555555;
    spacing: 2px;
    padding: 2px;
}
QToolBar::separator {
    background-color: #555555;
    width: 1px;
    margin: 4px 4px;
}
QToolButton {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px 8px;
}
QToolButton:hover {
    background-color: #262626;
    border-color: #7a7a7a;
}
QToolButton:pressed,
QToolButton:checked {
    background-color: #3b82f6;
    color: #ffffff;
    border-color: #7eb5ff;
}
QToolButton#account-menu-btn {
    background: transparent;
    color: #555555;
    border: none;
    padding: 0px;
    font-size: 14pt;
    font-weight: bold;
}
QToolButton#account-menu-btn:hover {
    background-color: #262626;
    color: #ffffff;
    border-radius: 3px;
}
QToolButton#account-menu-btn::menu-indicator { image: none; }

QStatusBar {
    background-color: #1a1a1a;
    border-top: 1px solid #555555;
    color: #ffffff;
}
QStatusBar QLabel {
    background-color: transparent;
    color: #ffffff;
}

QGraphicsView {
    background-color: #0e0e0e;
    border: none;
}

/* Generic labels */
QLabel {
    background-color: transparent;
    color: #ffffff;
}

/* Buttons */
QPushButton {
    background-color: #262626;
    color: #ffffff;
    border: 1px solid #7a7a7a;
    border-radius: 3px;
    padding: 5px 14px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: #333333;
    border-color: #c8c8c8;
}
QPushButton:pressed {
    background-color: #3b82f6;
    border-color: #7eb5ff;
}
QPushButton:default {
    border: 2px solid #7eb5ff;
}
QPushButton:disabled {
    color: #8a8a8a;
    border-color: #555555;
    background-color: #1a1a1a;
}

/* Text inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QDateEdit, QTimeEdit, QDateTimeEdit, QSpinBox {
    background-color: #262626;
    color: #ffffff;
    border: 1px solid #7a7a7a;
    border-radius: 3px;
    padding: 4px 6px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus, QSpinBox:focus {
    border-color: #7eb5ff;
}
QLineEdit:disabled, QTextEdit:disabled {
    color: #8a8a8a;
    background-color: #1a1a1a;
}

/* Combo boxes */
QComboBox {
    background-color: #262626;
    color: #ffffff;
    border: 1px solid #7a7a7a;
    border-radius: 3px;
    padding: 4px 8px;
    min-height: 18px;
}
QComboBox:hover {
    border-color: #c8c8c8;
}
QComboBox:focus {
    border-color: #7eb5ff;
}
QComboBox::drop-down {
    border-left: 1px solid #555555;
    width: 18px;
}
QComboBox QAbstractItemView {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #7a7a7a;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
    outline: none;
}

/* Checkboxes / radios */
QCheckBox, QRadioButton {
    color: #ffffff;
    spacing: 6px;
    background-color: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #c8c8c8;
    background-color: #262626;
}
QCheckBox::indicator {
    border-radius: 2px;
}
QRadioButton::indicator {
    border-radius: 7px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border-color: #7eb5ff;
}
QRadioButton::indicator:checked {
    background-color: #3b82f6;
    border: 4px solid #3b82f6;
}

/* Group boxes */
QGroupBox {
    border: 1px solid #555555;
    border-radius: 3px;
    margin-top: 6px;
    padding-top: 6px;
}
QGroupBox::title {
    color: #ffffff;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
}

/* Menus */
QMenu {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #7a7a7a;
    padding: 4px;
}
QMenu::item {
    padding: 5px 24px 5px 16px;
    border-radius: 2px;
}
QMenu::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #8a8a8a;
}
QMenu::separator {
    height: 1px;
    background: #555555;
    margin: 4px 6px;
}
QMenuBar {
    background-color: #1a1a1a;
    color: #ffffff;
    border-bottom: 1px solid #555555;
}
QMenuBar::item:selected {
    background-color: #262626;
}

/* Scrollbars (strong contrast — important for visibility) */
QScrollBar:vertical {
    background: #1a1a1a;
    width: 12px;
    margin: 0;
}
QScrollBar:horizontal {
    background: #1a1a1a;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #555555;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #7a7a7a;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
    background: transparent;
    border: none;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* Tree (used by AgendaView) */
QTreeWidget, QTreeView {
    background-color: #0e0e0e;
    alternate-background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #555555;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
    outline: none;
}
QTreeWidget::item, QTreeView::item {
    padding: 3px;
    border: none;
}
QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: #262626;
}
QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
}
QHeaderView::section {
    background-color: #1a1a1a;
    color: #ffffff;
    border: none;
    border-right: 1px solid #555555;
    border-bottom: 1px solid #555555;
    padding: 4px 6px;
    font-weight: bold;
}

/* Tooltips */
QToolTip {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #7a7a7a;
    padding: 4px 6px;
}

/* Dialogs / scroll area frame */
QDialog {
    background-color: #0e0e0e;
}
QScrollArea, QFrame {
    border: none;
}

/* Progress bar (used in status bar during sync) */
QProgressBar {
    background-color: #262626;
    border: 1px solid #555555;
    border-radius: 3px;
    text-align: center;
    color: #ffffff;
}
QProgressBar::chunk {
    background-color: #3b82f6;
}

/* ── Sidebar ────────────────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #1a1a1a;
}

QToolButton#mini-nav {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 14pt;
    color: #c8c8c8;
}
QToolButton#mini-nav:hover {
    background-color: #262626;
    color: #ffffff;
}

QLabel#mini-month-label {
    background: transparent;
    color: #c8c8c8;
    font-size: 11pt;
}

QLabel#section-heading {
    background: transparent;
    color: #8a8a8a;
    font-size: 9pt;
    font-weight: bold;
    padding: 8px 2px 4px 2px;
}

QLabel#account-heading {
    background: transparent;
    color: #8a8a8a;
    font-size: 9pt;
    font-weight: bold;
    padding: 2px 0px;
}

QWidget#cal-row {
    background: transparent;
    border-radius: 4px;
}
QWidget#cal-row:hover {
    background-color: #262626;
}

QLabel#cal-name {
    background: transparent;
    color: #c8c8c8;
}

QLabel#cal-placeholder {
    background: transparent;
    color: #8a8a8a;
    padding-left: 14px;
}

QPushButton#add-account {
    background: transparent;
    color: #8a8a8a;
    border: 1px dashed #3a3a3a;
    border-radius: 4px;
    padding: 6px 10px;
    min-height: 18px;
}
QPushButton#add-account:hover {
    background: #262626;
    color: #ffffff;
    border-style: solid;
    border-color: #7a7a7a;
}
QPushButton#add-account:pressed {
    background: #333333;
    border-color: #7eb5ff;
}

/* ── Invitee chips ──────────────────────────────────────────────────────── */
QFrame#inviteeChip {
    background-color: #2a2a2a;
    border: 1px solid #555555;
    border-radius: 10px;
    padding: 0px;
}
QFrame#inviteeChip QLabel {
    background: transparent;
    padding: 0 2px;
}
QToolButton#inviteeChipRemove {
    background: transparent;
    border: none;
    padding: 0 3px;
    margin: 0;
    color: #8a8a8a;
    font-size: 13pt;
    font-weight: bold;
    min-width: 0;
    min-height: 0;
}
QToolButton#inviteeChipRemove:hover {
    color: #f87171;
}

QWidget#sidebar QScrollBar:vertical {
    width: 8px;
}
QWidget#sidebar QScrollBar::handle:vertical {
    min-height: 18px;
}

/* Day-count slider in week view toolbar */
QSlider::groove:horizontal {
    background: #262626;
    border: 1px solid #3a3a3a;
    height: 4px;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #3b82f6;
    border: 1px solid #3b82f6;
    height: 4px;
    border-radius: 2px;
}
QSlider::add-page:horizontal {
    background: #262626;
    border: 1px solid #3a3a3a;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #7eb5ff;
    border: 1px solid #7eb5ff;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}
QSlider::handle:horizontal:hover {
    background: #a6cdff;
    border-color: #a6cdff;
}
QSlider::handle:horizontal:pressed {
    background: #ffffff;
    border-color: #ffffff;
}
